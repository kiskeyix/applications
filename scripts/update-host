#!/usr/bin/env ruby
# frozen_string_literal: true

# update-host - Luis Mondesi <luis.e.mondesi@gmail.com>
#
# Deploys shell/vim/mutt/git/claude configs from this repo (share/) as
# symlinks into $HOME, and can push a tarball of the repo out to remote
# hosts over SSH to do the same there.
#
# ~/.claude/settings.json is the one exception: it's a real file merged
# from share/claude/settings.json.example (see merge_claude_settings),
# not a symlink, since Claude Code writes into it at runtime.
#
# Usage:
#   update-host                 update all hosts listed in ~/.remote-hosts
#   update-host HOST1 HOST2     update just these hosts
#   update-host --local         relink this machine from the local checkout
#   update-host --verify        check this machine against the repo, no fixes
#   update-host --tar           build the distribution tarball and exit
#   update-host --send-key HOST push your SSH public key to HOST and exit

require "optparse"
require "socket"
require "fileutils"
require "open3"
require "json"

module UpdateHost
  VERSION = "2.0.0"

  REPO_ROOT = File.expand_path("..", __dir__)
  HOME = ENV.fetch("HOME")
  TAR_NAME = "Applications.tar.bz2"

  # source path (relative to share/) => dotfile it becomes under $HOME
  CONFIG_FILES = %w[
    shell/bash_profile
    shell/bashrc
    shell/inputrc
    shell/cvsrc
    vim
    mutt
    shell/screenrc
    shell/tmux.conf
    git-templates
    shell/iterm2_shell_integration.bash
    shell/ssh-agent-setup.bash
    shell/dir_colors
    claude/hooks
    claude/CLAUDE.md
    claude/commands
  ].freeze

  # source path (relative to share/) => dotfile it becomes under $HOME,
  # for entries that don't follow the default ".#{basename}" rule.
  DEST_OVERRIDES = {
    "vim" => File.join(".config", "vim"),
    "claude/hooks" => File.join(".claude", "hooks"),
    "claude/CLAUDE.md" => File.join(".claude", "CLAUDE.md"),
    "claude/commands" => File.join(".claude", "commands")
  }.freeze

  Options = Struct.new(
    :local, :verify, :tar_only, :send_key, :hosts_file, :local_path,
    :username, :ssh_port, :key, :jobs, :remove, :exclude, :verbose,
    keyword_init: true
  )

  # A small multi-line progress bar, one row per host, redrawn in place.
  # Falls back to plain log lines when stdout isn't a TTY (e.g. piped/CI).
  class MultiProgress
    BAR_WIDTH = 24

    def initialize(hosts, io: $stdout)
      @order = hosts
      @state = hosts.each_with_object({}) { |h, s| s[h] = [0, "queued"] }
      @mutex = Mutex.new
      @io = io
      @tty = io.tty?
      @drawn = false
    end

    def update(host, pct, label)
      @mutex.synchronize do
        @state[host] = [pct.clamp(0, 100), label]
        @tty ? redraw : @io.puts("#{host}: #{label} (#{pct}%)")
      end
    end

    def finish
      @io.print("\n") if @tty
    end

    private

    def redraw
      @io.print("\e[#{@order.size}A") if @drawn
      @order.each do |h|
        pct, label = @state[h]
        filled = (BAR_WIDTH * pct / 100.0).round
        bar = ("#" * filled) + ("-" * (BAR_WIDTH - filled))
        @io.printf("\e[2K%-22.22s [%s] %3d%%  %s\n", h, bar, pct, label)
      end
      @drawn = true
    end
  end

  # Accumulates --verify results, one line per check. `fail_check` means
  # there's a concrete fix (shown in the message); `warn` is advisory —
  # either the problem can't be acted on automatically, or the underlying
  # script (e.g. merge_claude_settings) already treats it as a no-op.
  class Verifier
    def initialize(io: $stdout)
      @io = io
      @counts = { ok: 0, warn: 0, fail: 0 }
    end

    def section(title)
      @io.puts "\n--- #{title} ---"
    end

    def ok(msg)
      record(:ok, "  ok    #{msg}")
    end

    def warn(msg)
      record(:warn, "  warn  #{msg}")
    end

    # Named fail_check, not fail: Kernel#fail (alias for raise) is a private
    # method on every object, and a plain `def fail` here would shadow it for
    # this class.
    def fail_check(msg)
      record(:fail, "  FAIL  #{msg}")
    end

    def failed?
      @counts[:fail].positive?
    end

    def summary
      @io.puts "\n--- Summary ---"
      @io.puts "  #{@counts[:ok]} ok, #{@counts[:warn]} warn, #{@counts[:fail]} fail"
      @io.puts "  See the FAIL lines above for how to fix each one." if failed?
    end

    private

    def record(kind, line)
      @counts[kind] += 1
      @io.puts line
    end
  end

  module_function

  def main(argv)
    opts = parse_options(argv)
    extra_hosts = argv

    if opts.tar_only
      create_tarball(opts)
    elsif opts.verify
      verify_local
    elsif opts.local
      relink_local
    elsif opts.send_key
      send_key(extra_hosts, opts)
    else
      hosts = extra_hosts.empty? ? hosts_from_file(opts.hosts_file) : extra_hosts
      hosts = filter_excluded(hosts, opts.exclude)
      update_remote(hosts, opts)
    end
  end

  def parse_options(argv)
    opts = Options.new(
      local: false, verify: false, tar_only: false, send_key: false,
      hosts_file: File.join(HOME, ".remote-hosts"),
      local_path: File.join(HOME, "Shared", "Software", "settings"),
      username: nil, ssh_port: 22, key: nil, jobs: 10, remove: false,
      exclude: nil, verbose: false
    )
    show_version = false

    parser = OptionParser.new do |o|
      o.banner = "Usage: update-host [options] [HOST1 HOST2 ...]"
      o.on("-l", "--local", "Relink localhost from this checkout and exit") { opts.local = true }
      o.on("--verify", "Check this machine against the repo and exit (no fixes)") { opts.verify = true }
      o.on("-C", "--tar", "--tarball", "Build the tarball only and exit") { opts.tar_only = true }
      o.on("--local-path PATH", "Tarball staging directory") { |v| opts.local_path = v }
      o.on("--hosts-file FILE", "Hosts file (default: ~/.remote-hosts)") { |v| opts.hosts_file = v }
      o.on("-u", "--username USER", "SSH username") { |v| opts.username = v }
      o.on("--ssh-port PORT", Integer, "SSH port (default: 22)") { |v| opts.ssh_port = v }
      o.on("-k", "--key FILE", "SSH identity file") { |v| opts.key = v }
      o.on("-j", "--jobs N", Integer, "Max parallel host updates (default: 10)") { |v| opts.jobs = v }
      o.on("-r", "--remove", "Remove the remote tarball after unpacking") { opts.remove = true }
      o.on("--exclude PATTERN", "Regex of hostnames to skip") { |v| opts.exclude = v }
      o.on("-s", "--send-key", "Push local SSH public key to targets and exit") { opts.send_key = true }
      o.on("-V", "--verbose", "Verbose output") { opts.verbose = true }
      o.on("-v", "--version", "Print version and exit") { show_version = true }
      o.on("-h", "--help", "Show this help") { puts o; exit }
    end
    parser.parse!(argv)

    if show_version
      puts "update-host #{VERSION}"
      exit
    end

    opts
  end

  def filter_excluded(hosts, pattern)
    return hosts if pattern.nil? || pattern.empty?

    re = Regexp.new(pattern)
    hosts.reject { |h| h =~ re }
  end

  def hosts_from_file(path)
    return [] unless File.readable?(path)

    File.readlines(path).filter_map do |line|
      line = line.strip
      next nil if line.empty? || line.start_with?("#")

      if line =~ /^\d+\.\d+\.\d+\.\d+\s+(\S+)/
        Regexp.last_match(1)
      elsif line =~ /^(\S+)/
        Regexp.last_match(1)
      end
    end.uniq
  end

  def alive?(host, port, timeout = 3)
    Socket.tcp(host, port, connect_timeout: timeout) { true }
  rescue StandardError
    false
  end

  def ssh_target(host, opts)
    opts.username && !opts.username.empty? ? "#{opts.username}@#{host}" : host
  end

  def ssh_base(opts)
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-p", opts.ssh_port.to_s]
    cmd += ["-i", opts.key] if opts.key
    cmd
  end

  def scp_base(opts)
    cmd = ["scp", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-P", opts.ssh_port.to_s]
    cmd += ["-i", opts.key] if opts.key
    cmd
  end

  def run_cmd(cmd, verbose)
    if verbose
      warn("+ #{cmd.join(' ')}")
      system(*cmd)
    else
      out, status = Open3.capture2e(*cmd)
      warn(out) unless status.success?
      status.success?
    end
  end

  # ----- tarball -----

  def create_tarball(opts)
    abort "No git checkout at #{REPO_ROOT} (expected #{REPO_ROOT}/.git)" unless Dir.exist?(File.join(REPO_ROOT, ".git"))

    FileUtils.mkdir_p(opts.local_path)
    out_path = File.join(opts.local_path, TAR_NAME)

    tar_version = `tar --version 2>&1`
    bsdtar = tar_version =~ /bsdtar|libarchive/i

    excludes = ["--exclude=.git", "--exclude=.gitignore", "--exclude=.github"]
    gitignore = File.join(REPO_ROOT, ".gitignore")
    if File.readable?(gitignore)
      File.readlines(gitignore).each do |line|
        line = line.strip
        next if line.empty? || line.start_with?("#")

        # tar's --exclude does a literal fnmatch per path component; a
        # gitignore-style trailing "/" (directory marker) never matches.
        excludes << "--exclude=#{line.delete_suffix('/')}"
      end
    end

    bsd_only = bsdtar ? %w[--no-mac-metadata --no-acls --no-xattrs --no-fflags] : []
    repo_dirname = File.basename(REPO_ROOT)

    Dir.chdir(File.dirname(REPO_ROOT)) do
      cmd = ["tar", *excludes, *bsd_only, "-cjf", out_path, repo_dirname]
      system(*cmd) or abort "tar failed: #{cmd.join(' ')}"
    end

    puts "# Created #{out_path}"
    out_path
  end

  # ----- local relink -----

  def relink_local
    abort "No git checkout at #{REPO_ROOT} (expected #{REPO_ROOT}/.git)" unless Dir.exist?(File.join(REPO_ROOT, ".git"))

    FileUtils.mkdir_p(File.join(HOME, ".backup"), mode: 0o700)
    FileUtils.mkdir_p(File.join(HOME, "tmp"))
    sig = File.join(HOME, ".signaturerc")
    FileUtils.touch(sig) unless File.exist?(sig)

    update_submodules_local

    CONFIG_FILES.each do |rel|
      dotfile = File.join(HOME, dest_rel(rel))
      target = File.join(REPO_ROOT, "share", rel)
      relink(dotfile, target)
    end

    merge_claude_settings

    puts "localhost: relinked #{CONFIG_FILES.size} configs"
  end

  def dest_rel(rel)
    DEST_OVERRIDES[rel] || ".#{File.basename(rel)}"
  end

  def relink(link_path, target_path)
    FileUtils.mkdir_p(File.dirname(link_path))
    if File.symlink?(link_path)
      return if File.readlink(link_path) == target_path

      File.unlink(link_path)
    elsif File.exist?(link_path)
      FileUtils.mv(link_path, "#{link_path}.bak", force: true)
    end
    File.symlink(target_path, link_path)
  end

  def update_submodules_local
    Dir.chdir(REPO_ROOT) do
      unless system("git", "submodule", "init") && system("git", "submodule", "update")
        warn "Failed to update git submodules. Try:\n  cd #{REPO_ROOT} && git submodule update --init --remote --merge"
      end
    end
  end

  # ----- verify -----
  #
  # Read-only counterpart to relink_local: checks whether this machine
  # already matches what --local would produce, without changing anything.
  # `home:`/`repo_root:` default to the real constants but are overridable so
  # tests can point every check at a scratch directory (see the note at
  # HOME/REPO_ROOT's definition on why those constants themselves aren't).
  def verify_local(home: HOME, repo_root: REPO_ROOT, io: $stdout)
    v = Verifier.new(io: io)
    verify_symlinks(v, home: home, repo_root: repo_root)
    verify_claude_settings(v, home: home, repo_root: repo_root)
    verify_hook_executability(v, repo_root: repo_root)
    verify_git_templates(v, home: home)
    verify_submodule(v, repo_root: repo_root)
    verify_supporting_paths(v, home: home)
    verify_claude_version(v)
    v.summary
    exit 1 if v.failed?
  end

  def verify_symlinks(v, home: HOME, repo_root: REPO_ROOT)
    v.section("Dotfile symlinks")

    CONFIG_FILES.each do |rel|
      target = File.join(repo_root, "share", rel)
      dotfile = File.join(home, dest_rel(rel))
      label = "~/#{dest_rel(rel)}"

      unless File.exist?(target)
        v.fail_check("#{label}: source #{target} is missing — check your checkout (git status)")
        next
      end

      if File.symlink?(dotfile)
        if File.readlink(dotfile) == target
          v.ok("#{label} -> #{target}")
        else
          v.fail_check("#{label} points to #{File.readlink(dotfile)} (expected #{target}) — run: update-host --local")
        end
      elsif File.exist?(dotfile)
        v.warn("#{label} is a real file/dir, not our symlink (--local would move it to .bak)")
      else
        v.fail_check("#{label} missing — run: update-host --local")
      end
    end
  end

  # Resolves the same directory merge_claude_settings writes into, so verify
  # and deploy can never disagree about where settings.json lives.
  def claude_config_dir(home: HOME)
    dir = ENV["CLAUDE_CONFIG_DIR"]
    dir.nil? || dir.empty? ? File.join(home, ".claude") : dir
  end

  def verify_claude_settings(v, home: HOME, repo_root: REPO_ROOT)
    v.section("Claude settings")

    example = File.join(repo_root, "share", "claude", "settings.json.example")
    unless File.readable?(example)
      v.fail_check("template missing: #{example}")
      return
    end

    target = File.join(claude_config_dir(home: home), "settings.json")

    v.warn("#{target} is a symlink (should be a real file Claude Code can write into)") if File.symlink?(target)

    unless File.exist?(target)
      v.fail_check("#{target} missing — run: update-host --local")
      return
    end

    begin
      template = JSON.parse(File.read(example))
      current  = JSON.parse(File.read(target))
    rescue JSON::ParserError => e
      # Matches merge_claude_settings, which also rescues this and no-ops:
      # --local would not fix a genuinely malformed live file either.
      v.warn("#{target} (or the template) is not valid JSON (#{e.message})")
      return
    rescue SystemCallError => e
      v.warn("could not read #{target} (#{e.message})")
      return
    end

    if deep_merge(template, current) == current
      v.ok("#{target} has all template keys merged")
    else
      v.fail_check("#{target} is missing keys from the template — run: update-host --local")
    end
  end

  def verify_hook_executability(v, repo_root: REPO_ROOT)
    v.section("Hook executability")

    patterns = [
      File.join(repo_root, "share", "claude", "hooks", "*.sh"),
      File.join(repo_root, "share", "git-templates", "hooks", "*")
    ]
    patterns.each do |pattern|
      matches = Dir.glob(pattern).select { |path| File.file?(path) }.sort
      if matches.empty?
        v.fail_check("no hook files found matching #{pattern} — is the checkout complete?")
        next
      end

      matches.each do |path|
        if File.executable?(path)
          v.ok("#{path} is executable")
        else
          v.fail_check("#{path} is not executable — run: chmod +x #{path}")
        end
      end
    end
  end

  def verify_git_templates(v, home: HOME)
    v.section("Git template wiring")

    check_git_config(v, "init.templatedir", File.join(home, ".git-templates"), home: home)
    check_git_config(v, "core.hooksPath", File.join(home, ".git-templates", "hooks"), home: home)
  end

  # update-host never sets git config itself, so a mismatch here is advisory,
  # not something --local would fix. `git config --global --get` exits 1 for
  # the ordinary "key unset" case — that's only status.exitstatus == 1 with no
  # stderr; anything else (missing git binary, unreadable ~/.gitconfig, a
  # future git changing exit codes) is a distinct failure and must not be
  # reported as if the key were simply unset.
  def check_git_config(v, key, expected, home: HOME)
    stdout, stderr, status = Open3.capture3("git", "config", "--global", "--get", key)

    actual =
      if status.success?
        stdout.strip
      elsif status.exitstatus == 1 && stderr.strip.empty?
        ""
      else
        v.warn("could not read git #{key}: #{stderr.strip} (exit #{status.exitstatus})")
        return
      end

    expand = ->(path) { path.sub(/\A~/, home) }

    if expand.call(actual) == expand.call(expected)
      v.ok("git #{key} = #{actual}")
    else
      v.warn("git #{key} = '#{actual.empty? ? 'unset' : actual}' (expected #{expected}) " \
             "— run: git config --global #{key} '#{expected}'")
    end
  rescue Errno::ENOENT
    v.warn("git not found on PATH; cannot check #{key}")
  end

  def verify_submodule(v, repo_root: REPO_ROOT)
    v.section("Vim submodule")

    nerdtree = File.join(repo_root, "share", "vim", "pack", "vendor", "start", "nerdtree")
    if Dir.exist?(nerdtree) && !Dir.empty?(nerdtree)
      v.ok("nerdtree submodule initialized")
    else
      v.fail_check("nerdtree submodule not initialized (#{nerdtree}) — run: update-host --local")
    end
  end

  def verify_supporting_paths(v, home: HOME)
    v.section("Supporting paths")

    backup = File.join(home, ".backup")
    if Dir.exist?(backup)
      mode = format("%o", File.stat(backup).mode & 0o777)
      mode == "700" ? v.ok("~/.backup exists (mode 700)") : v.warn("~/.backup exists but mode is #{mode} (expected 700)")
    else
      v.fail_check("~/.backup missing — run: update-host --local")
    end

    tmp = File.join(home, "tmp")
    Dir.exist?(tmp) ? v.ok("~/tmp exists") : v.fail_check("~/tmp missing — run: update-host --local")

    sig = File.join(home, ".signaturerc")
    File.exist?(sig) ? v.ok("~/.signaturerc exists") : v.fail_check("~/.signaturerc missing — run: update-host --local")
  end

  # Advisory tie-in with the check-claude-version.sh SessionStart hook: skipped
  # entirely when `claude` isn't installed or CLAUDE_CONFIG_DIR isn't set,
  # since neither is something this repo controls.
  def verify_claude_version(v)
    return unless command_on_path?("claude")

    config_dir = ENV["CLAUDE_CONFIG_DIR"]
    return if config_dir.nil? || config_dir.empty?

    v.section("Claude Code version")

    installed, status = Open3.capture2("claude", "--version")
    unless status.success?
      v.warn("`claude --version` exited #{status.exitstatus}; cannot check version")
      return
    end
    installed = installed.split.first
    stamp = File.join(config_dir, ".claude-code-verified-version")
    verified = File.readable?(stamp) ? File.read(stamp).strip : nil

    if installed && installed == verified
      v.ok("Claude Code #{installed} verified against changelog")
    else
      v.warn("Claude Code #{installed || 'version unknown'} not verified against changelog " \
             "(last verified: #{verified || 'never'}) — run /claude-update-check")
    end
  end

  def command_on_path?(cmd)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, cmd)) }
  end

  # Materializes ~/.claude/settings.json (or $CLAUDE_CONFIG_DIR/settings.json)
  # from share/claude/settings.json.example. Never symlinked: Claude Code and
  # `claude plugin install` write into this file at runtime, so the live file
  # always wins over the template on any key it already sets (deep_merge).
  # Arrays are unioned so template entries still accumulate; elements are
  # compared after $HOME→~ canonicalisation so a hook Claude Code rewrote to an
  # absolute path is not re-added by the template's ~-relative form on every run.
  def merge_claude_settings
    example = File.join(REPO_ROOT, "share", "claude", "settings.json.example")
    return unless File.readable?(example)

    config_dir = claude_config_dir
    FileUtils.mkdir_p(config_dir)
    target = File.join(config_dir, "settings.json")

    template = JSON.parse(File.read(example))

    unless File.exist?(target)
      File.write(target, JSON.pretty_generate(template))
      puts "# created #{target} from template"
      return
    end

    current = JSON.parse(File.read(target))
    merged  = deep_merge(template, current)
    File.write(target, JSON.pretty_generate(merged)) if merged != current
  rescue JSON::ParserError => e
    warn "update-host: skipping Claude settings merge (#{e.message})"
  end

  # Recursively merge `override` onto `base`:
  #   Hash  + Hash  -> merged key by key, recursing on shared keys
  #   Array + Array -> union; elements are de-duplicated by their canonical form
  #                    (keeping the `override` copy on a collision), so template
  #                    entries accumulate without re-adding ones the live file
  #                    already has in a different-but-equivalent shape
  #   otherwise     -> `override` wins (the live file is authoritative)
  def deep_merge(base, override)
    if base.is_a?(Hash) && override.is_a?(Hash)
      base.merge(override) { |_k, b, o| deep_merge(b, o) }
    elsif base.is_a?(Array) && override.is_a?(Array)
      seen = {}
      (override + base).each_with_object([]) do |el, acc|
        key = canonicalize(el)
        next if seen[key]

        seen[key] = true
        acc << el
      end
    else
      override
    end
  end

  # Deep copy of `val` with every string under $HOME rewritten to a ~-relative
  # path, so entries that differ only by ~ vs. an expanded $HOME compare equal.
  def canonicalize(val)
    case val
    when Hash   then val.transform_values { |v| canonicalize(v) }
    when Array  then val.map { |v| canonicalize(v) }
    when String then val.sub(%r{\A#{Regexp.escape(HOME)}/}, "~/")
    else val
    end
  end

  # ----- remote update -----

  def remote_link_script
    CONFIG_FILES.map do |rel|
      dotfile = dest_rel(rel)
      src = "Applications/share/#{rel}"
      "mkdir -p $(dirname #{dotfile}) && rm -rf #{dotfile} && ln -sf #{src} #{dotfile}"
    end.join(" && ")
  end

  def update_remote(hosts, opts)
    if hosts.empty?
      warn "No hosts to update. Check #{opts.hosts_file} or pass hosts as arguments."
      return
    end

    tar_path = File.join(opts.local_path, TAR_NAME)
    create_tarball(opts) unless File.readable?(tar_path)

    progress = MultiProgress.new(hosts)
    queue = Queue.new
    hosts.each { |h| queue << h }
    results = {}
    mutex = Mutex.new

    workers = [[opts.jobs, hosts.size].min, 1].max
    threads = Array.new(workers) do
      Thread.new do
        loop do
          host = begin
            queue.pop(true)
          rescue ThreadError
            nil
          end
          break unless host

          ok = update_one_host(host, opts, tar_path, progress)
          mutex.synchronize { results[host] = ok }
        end
      end
    end
    threads.each(&:join)
    progress.finish

    failed = results.reject { |_, ok| ok }.keys
    unless failed.empty?
      warn "Failed hosts: #{failed.join(', ')}"
      exit 1
    end
  end

  def update_one_host(host, opts, tar_path, progress)
    progress.update(host, 5, "checking")
    unless alive?(host, opts.ssh_port)
      progress.update(host, 100, "unreachable")
      return false
    end

    target = ssh_target(host, opts)
    ssh = ssh_base(opts)
    scp = scp_base(opts)

    progress.update(host, 15, "prep")
    run_cmd(ssh + [target, "mkdir -p tmp ~/.backup && chmod 700 ~/.backup && touch ~/.signaturerc"], opts.verbose)

    progress.update(host, 35, "uploading")
    unless run_cmd(scp + [tar_path, "#{target}:tmp/"], opts.verbose)
      progress.update(host, 100, "upload failed")
      return false
    end

    progress.update(host, 60, "unpacking")
    unless run_cmd(ssh + [target, "bzcat tmp/#{TAR_NAME} | tar xf -"], opts.verbose)
      progress.update(host, 100, "unpack failed")
      return false
    end

    run_cmd(ssh + [target, "rm -f tmp/#{TAR_NAME}"], opts.verbose) if opts.remove

    progress.update(host, 90, "linking")
    unless run_cmd(ssh + [target, remote_link_script], opts.verbose)
      progress.update(host, 100, "link failed")
      return false
    end

    progress.update(host, 100, "done")
    true
  end

  # ----- send-key -----

  def send_key(hosts, opts)
    if hosts.empty?
      warn "usage: update-host --send-key HOST1 [HOST2 ...]"
      exit 1
    end

    pub_keys = %w[id_ed25519.pub id_rsa.pub].map { |f| File.join(HOME, ".ssh", f) }
    system("ssh-keygen", "-t", "ed25519") unless pub_keys.any? { |f| File.exist?(f) }

    hosts.each do |host|
      target = ssh_target(host, opts)
      cmd = ["ssh-copy-id", "-p", opts.ssh_port.to_s, target]
      warn "failed to send key to #{host}" unless system(*cmd)
    end
  end
end

UpdateHost.main(ARGV) if $PROGRAM_NAME == __FILE__
