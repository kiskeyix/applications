function fastprompt()
{
    unset PROMPT_COMMAND
    case $TERM in
  *term* | rxvt | vt100 | tmux* )  
      PS1="\u@\h:\W > \[\033]0;\u@\h:\w\007\]" ;;
  *) 
      PS1="\u@\h:\W > " ;;
    esac
}


function powerprompt()
{
    _powerprompt()
    {
        if [[ -r /proc/loadavg ]]; then
            read _LOAD _ < /proc/loadavg
        elif [[ -z "$_LOAD" || $(( SECONDS - ${_LOAD_TS:-0} )) -ge 30 ]]; then
            _LOAD=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}') || _LOAD=$(command uptime 2>/dev/null | sed -e "s/.*: \([^,\ ]*\).*/\1/" -e "s/ //g")
            _LOAD_TS=$SECONDS
        fi
        if [[ -z "${_LOAD:-}" ]]; then
            _LOAD="NOLOAD_CMD"
        fi
        if command -v __git_ps1 > /dev/null; then
            _GIT_BRANCH=$(__git_ps1 " (%s)")
        fi
        case $TERM in
            *term* | rxvt* | ansi | tmux* )
                echo -ne "\033]0;${USER}@${HOSTNAME}${_GIT_BRANCH}: ${PWD/$HOME/~}\033\\" ;;
        esac
    }

    PROMPT_COMMAND=_powerprompt;
    case $TERM in
        *term* | rxvt* | vt100 | ansi | tmux* )
            PS1="${cyan}[\t - \$_LOAD \u@\h\$_GIT_BRANCH]$NC \w \n\\$> " ;;
            # \[\033]0;[\h/\u] \w\007\]" ;; this creates a problem
            # on Ubuntu 6.06/6.10's Gnome-Terminal. The first 32 (or so)
            # characters typed cause the cursor to re-scan the number
            # of characters from beginning to ending rapidly,
            # causing a weird (ie annoying) visual effect.
            # Now echo -ne '' in _powerprompt fixes this.
        linux )
            PS1="${cyan}[\t - \$_LOAD]$NC\n[\u@\h \#\$_GIT_BRANCH] \w \n\\$> " ;;
        * )
            # sets no terminal title and has no color
            PS1="[\t - \$_LOAD \u@\h\$_GIT_BRANCH] \w \n\\$> " ;;
    esac
}

function gitprompt()
{
    local _prefix
    for _prefix in /opt/homebrew /usr/local; do
        if [ -f "$_prefix/opt/bash-git-prompt/share/gitprompt.sh" ]; then
            __GIT_PROMPT_DIR="$_prefix/opt/bash-git-prompt/share"
            source "$_prefix/opt/bash-git-prompt/share/gitprompt.sh"
            return
        fi
    done
}

