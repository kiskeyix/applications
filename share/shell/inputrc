# /etc/inputrc - global inputrc for libreadline
# See readline(3readline) and `info rluserman' for more information.

# Be 8 bit clean.
set input-meta On
set output-meta On

# allow iso-latin1 characters set convert-meta to off
set convert-meta Off

# Leave enable-bracketed-paste at its default. Readline 8.1+ (bash 5.1+) turns
# it on already. Readline 7.0 (bash 4.4, /bin/bash on older RHEL) in vi mode
# requests bracketed paste but cannot parse the opening \e[200~ marker, so
# every paste starts with "(arg: 200)" and the text goes in as keystrokes.

# lems 2003-01-05 13:00 
set editing-mode vi
set keymap vi-insert
#set history-preserve-point On
set horizontal-scroll-mode Off
set expand-tilde On
set show-all-if-ambiguous On
set completion-ignore-case On 

$if mode=vi
    # append to end of line A La Emacs
    Control-e: vi-append-eol

$endif
