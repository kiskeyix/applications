"
" gvimrc — GUI-only overrides for gVim / MacVim.
"
" Keep this file light: the GUI sources ~/.config/vim/vimrc first, then this
" file, so everything that is not strictly GUI-specific lives in vimrc.
"
" edited by Luis Mondesi <lemsx1@gmail.com>

" Full mouse support in the GUI. The terminal keeps mouse=v (set in vimrc) so
" the terminal emulator's own copy/paste keeps working.
set mouse=a

" GUI colours: peachpuff is a light scheme that reads well in gVim/MacVim.
" (The terminal keeps its own scheme from vimrc.)
colorscheme peachpuff
" Readable folding column in the GUI.
hi FoldColumn term=standout ctermfg=4 ctermbg=7 guifg=#ff8060 guibg=PeachPuff

" Font — first available wins (Linux gVim uses "Name Size", MacVim "Name:hSIZE").
set guifont=DejaVu\ Sans\ Mono\ 14,Menlo:h18

" Open a large window by default.
set lines=50 columns=180
